# Copy to deploy.env (git-ignored) to deploy your own instance without editing
# worker/wrangler.jsonc. Unset values keep the defaults from that file.

# Cloudflare account to deploy to (`pnpm -C worker exec wrangler whoami`).
CLOUDFLARE_ACCOUNT_ID=

# Your domain. Sites are served on {username}-{siteId}.<APEX_HOST>.
APEX_HOST=

# Cloudflare zone that holds APEX_HOST. Defaults to APEX_HOST.
# ZONE_NAME=

# R2 bucket for sites and assets. Defaults to the bucket in wrangler.jsonc.
# R2_BUCKET_NAME=
