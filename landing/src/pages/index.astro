---
// The page is for the human. The only "code" on it is the sentence they say to
// their agent; the agent finds everything else in /llms.txt and the skill.
const ask = "Publish this with agenthost.page and send me the private link.";

// Source repo, configurable at build time: `PUBLIC_GITHUB_URL=https://github.com/you/agenthost`.
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL ?? "https://github.com/ceifa/agenthost";
const skillTreeUrl = `${githubUrl}/tree/main/skills/agenthost`;

// A real sequence, so it is numbered.
const steps = [
  ["You ask.", "One sentence, in the agent you already use. Nothing to install, no account to create."],
  ["It publishes.", "The agent reads the instructions at agenthost.page on its own and uploads what it built."],
  ["You get a link.", "Private, ready to open, safe to forward. Publish again and the address stays the same."],
];

// Plain-language reasons to reach for it. Each one is something a person recognizes.
const uses = [
  ["The report it just wrote", "A real page with a link, instead of a wall of text pasted into chat."],
  ["A folder of markdown", "Turns into a docs site with a sidebar, search-friendly headings and next/previous."],
  ["The prototype", "The built site, live, exactly as it renders. Send it to someone before it is finished."],
  ["A big file", "Videos, datasets, builds. Up to 100 MB free, 5 GB on paid accounts, straight download."],
];

const agents = ["Claude Code", "Cursor", "Codex", "OpenClaw", "Hermes"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>agenthost: ask your agent, get a private link</title>
    <meta
      name="description"
      content="Ask your AI agent to publish a page, a docs folder or a large file with agenthost, and it hands you a private link. Free, no signup, nothing to install."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* Same ink and amber as before. Prose is now a sans; the mono voice is kept
         for exactly one thing: the sentence you say to your agent. */
      :root {
        --bg: #0c0d0f;
        --panel: #131110;
        --fg: #ebe8e1;
        --dim: #8b8d92;
        --line: #24262b;
        --accent: #f2b544;
        --sans: "IBM Plex Sans", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        --mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font: 400 18px/1.6 var(--sans);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      a { color: inherit; text-decoration: none; }
      p { margin: 0; }
      .wrap { max-width: 880px; margin: 0 auto; padding: 0 28px; }

      .brand { font: 500 15px var(--mono); }

      /* ---- hero ---- */
      .hero .wrap { padding-top: 120px; }
      h1 {
        font-weight: 600;
        font-size: clamp(38px, 6.6vw, 66px);
        line-height: 1.06;
        letter-spacing: -0.035em;
        margin: 0 0 24px;
        text-wrap: balance;
      }
      .lead { color: var(--dim); font-size: 20px; max-width: 36em; }
      .lead strong { color: var(--fg); font-weight: 500; }

      /* ---- the ask: the one moment on the page ---- */
      .ask {
        margin-top: 44px;
        background: var(--panel);
        border: 1px solid var(--line);
        border-left: 3px solid var(--accent);
        padding: 26px 30px 24px;
      }
      .ask .hint { color: var(--dim); font-size: 14px; margin-bottom: 12px; }
      .ask blockquote {
        margin: 0;
        font: 500 clamp(17px, 2.4vw, 24px)/1.5 var(--mono);
        color: var(--fg);
        letter-spacing: -0.01em;
      }
      .ask blockquote::before { content: "“"; color: var(--accent); }
      .ask blockquote::after { content: "”"; color: var(--accent); }
      .ask .row { display: flex; align-items: center; gap: 16px; margin-top: 18px; flex-wrap: wrap; }
      .copy {
        font: 500 14px var(--sans);
        color: var(--bg);
        background: var(--accent);
        border: 0;
        padding: 9px 16px;
        cursor: pointer;
      }
      .copy:hover { filter: brightness(1.07); }
      .copy[data-done] { background: var(--fg); }
      .works { color: var(--dim); font-size: 14px; }
      .works span { color: var(--fg); }

      /* ---- sections ---- */
      section .wrap { padding-top: 96px; }
      h2 {
        font-weight: 600;
        font-size: 30px;
        letter-spacing: -0.025em;
        line-height: 1.2;
        margin: 0 0 8px;
      }
      .sub { color: var(--dim); max-width: 38em; font-size: 18px; }

      /* Hairline rows carry every list on the page. */
      .rows { margin: 30px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
      .rows li {
        display: grid;
        grid-template-columns: 2.2em 1fr;
        gap: 0 22px;
        padding: 22px 0;
        border-bottom: 1px solid var(--line);
      }
      .rows li:has(.what) { grid-template-columns: 16em 1fr; }
      .rows .n { color: var(--accent); font: 400 15px var(--mono); padding-top: 3px; }
      .rows .what { font-weight: 500; }
      .rows .how { color: var(--dim); }
      .rows b { font-weight: 500; color: var(--fg); }

      /* Facts about privacy read as three short paragraphs, no boxes. */
      .facts { margin-top: 28px; display: grid; gap: 18px; color: var(--dim); max-width: 40em; }
      .facts p b { color: var(--fg); font-weight: 500; }

      .note { margin-top: 28px; color: var(--dim); font-size: 15px; }
      .note a, .facts a, .sub a { border-bottom: 1px solid var(--line); }
      .note a:hover, .facts a:hover, .sub a:hover { color: var(--fg); border-bottom-color: var(--dim); }

      /* ---- closing ask ---- */
      .again .wrap { padding-top: 96px; }
      .again .ask { margin-top: 28px; }

      /* ---- footer ---- */
      footer .wrap { margin-top: 96px; padding-bottom: 64px; }
      footer .foot {
        border-top: 1px solid var(--line);
        padding-top: 24px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px 22px;
        align-items: center;
        font-size: 14px;
        color: var(--dim);
      }
      footer .brand { color: var(--fg); }
      footer a:hover { color: var(--fg); }
      footer .gh { margin-left: auto; display: inline-flex; }

      :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

      @media (max-width: 560px) {
        body { font-size: 17px; }
        .hero .wrap { padding-top: 72px; }
        .lead { font-size: 17px; }
        section .wrap, .again .wrap { padding-top: 72px; }
        .rows li:has(.what) { grid-template-columns: 1fr; gap: 4px; }
      }
    </style>
  </head>
  <body>
    <header class="hero">
      <div class="wrap">
        <h1>Your agent built it.<br />Now let someone see it.</h1>
        <p class="lead">
          Ask your AI agent to publish a page, a docs folder or a large file with agenthost.
          It hands you back a private link. <strong>Free, no signup, nothing to install.</strong>
        </p>

        <div class="ask">
          <p class="hint">Try it now. Say this to your agent:</p>
          <blockquote id="ask-text">{ask}</blockquote>
          <div class="row">
            <button class="copy" type="button" data-copy={ask}>Copy the sentence</button>
            <p class="works">Works in <span>{agents.join(", ")}</span> and any agent that can run a shell.</p>
          </div>
        </div>
      </div>
    </header>

    <main>
      <section id="how">
        <div class="wrap">
          <h2>What happens next</h2>
          <p class="sub">About ten seconds, start to finish.</p>
          <ol class="rows">
            {steps.map(([what, how], i) => (
              <li><span class="n">{i + 1}</span><p><b>{what}</b> <span class="how">{how}</span></p></li>
            ))}
          </ol>
        </div>
      </section>

      <section id="uses">
        <div class="wrap">
          <h2>Anything that needs to leave the machine</h2>
          <p class="sub">The moment an agent finishes something, the next question is how to show it to a person.</p>
          <ul class="rows">
            {uses.map(([what, how]) => (
              <li><span class="what">{what}</span><span class="how">{how}</span></li>
            ))}
          </ul>
        </div>
      </section>

      <section id="private">
        <div class="wrap">
          <h2>Private unless you decide otherwise</h2>
          <div class="facts">
            <p><b>Only people with the link get in.</b> Each link carries its own key. The bare address asks for it, and every page has a share button that makes a fresh link.</p>
            <p><b>Search engines never see it.</b> Every hosted site is marked not to be indexed.</p>
            <p><b>Nothing lingers.</b> A free site is removed 15 days after its last publish. Publish again and the clock resets, at the same address.</p>
          </div>
        </div>
      </section>

      <section id="open">
        <div class="wrap">
          <h2>Free and open</h2>
          <p class="sub">
            Anonymous publishing is free and needs no card. The whole thing is open source under MIT,
            so you can read exactly what runs, or <a href={githubUrl}>host your own</a>.
          </p>
          <p class="note">
            Building an agent? The publish contract lives at <a href="/llms.txt">agenthost.page/llms.txt</a>,
            and ships as an <a href={skillTreeUrl}>Agent Skill</a> you can install once and keep.
          </p>
        </div>
      </section>

      <section class="again">
        <div class="wrap">
          <h2>Still curious? That is the whole product.</h2>
          <div class="ask">
            <p class="hint">Say this to your agent:</p>
            <blockquote>{ask}</blockquote>
            <div class="row">
              <button class="copy" type="button" data-copy={ask}>Copy the sentence</button>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap foot-wrap"><div class="foot">
        <span class="brand">agenthost</span>
        <a href="/llms.txt">llms.txt</a>
        <a href={`${githubUrl}/blob/main/LICENSE`} target="_blank" rel="noopener">MIT</a>
        <a class="gh" href={githubUrl} target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        </a>
      </div></div>
    </footer>

    <script>
      // The copy button is the only interaction. Label flips to confirm, then returns.
      for (const btn of document.querySelectorAll<HTMLButtonElement>(".copy")) {
        const label = btn.textContent;
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? "");
            btn.textContent = "Copied";
            btn.dataset.done = "";
            setTimeout(() => { btn.textContent = label; delete btn.dataset.done; }, 1600);
          } catch {
            btn.textContent = "Select it and copy";
          }
        });
      }
    </script>
  </body>
</html>
