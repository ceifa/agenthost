---
// The publish command, as a terminal transcript (prompt colored separately).
const cmdHtml = `<span class="tp">$</span> tar czf - -C ./dist . | curl -s --data-binary @- '<span class="tu">https://agenthost.page/publish?id=myblog</span>'`;

// The JSON that comes back. shareUrl is the payoff; secrets are masked.
const respHtml = `<span class="tb">{</span>
  <span class="tk">"shareUrl"</span>:   <span class="thi">"https://cleverotter4f2-myblog.agenthost.page/?k=•••"</span>  <span class="tc"># ← give a human</span>
  <span class="tk">"url"</span>:        <span class="tv">"https://cleverotter4f2-myblog.agenthost.page/"</span>
  <span class="tk">"username"</span>:   <span class="tv">"cleverotter4f2"</span>
  <span class="tk">"ownerToken"</span>: <span class="tsec">"••••••••••"</span>   <span class="tc"># shown once. save it</span>
  <span class="tk">"accessKey"</span>:  <span class="tsec">"••••••••••"</span>   <span class="tc"># shown once</span>
<span class="tb">}</span>`;

// Single-file publish, no tar step. The body is sniffed, so no header either.
const fileHtml = `<span class="tp">$</span> curl -s --data-binary @report.md '<span class="tu">https://agenthost.page/publish?id=report</span>'`;

// Same address, second time — needs only the token you kept.
const redeployHtml = `<span class="tp">$</span> tar czf - -C ./dist . | curl -s --data-binary @- \\
    <span class="tf">-H</span> 'Authorization: Bearer <span class="tu">$OWNER_TOKEN</span>' \\
    '<span class="tu">https://agenthost.page/publish?id=myblog&username=$USER</span>'`;

// Terse spec rows — label, then one line of fact.
const spec = [
  ["Private by default", "Every site and asset sits behind an access key. The share link signs a visitor in once and stays reusable."],
  ["Large files, direct", "Videos and other binaries upload straight to R2. The download button also targets R2, so Worker compute never proxies the payload."],
  ["Markdown → docs", "A folder of <code>.md</code> becomes a sidebar'd site: <code>SUMMARY.md</code> ordering, GFM, mermaid. Mix in <code>.html</code> freely."],
  ["Own subdomain", "Each site is the root of its own subdomain, so <code>/css/app.css</code> and <code>./css/app.css</code> both resolve with nothing to configure."],
  ["Redeploy in place", "Keep the <code>ownerToken</code> and ship again to the exact same address. Read-after-write is strong, so you can verify the instant it returns."],
  ["Public toggle", "One POST drops the gate. One more rotates the access key and invalidates every old link at once."],
  ["Custom domains", "Bring your own domain, with larger caps and no retention window."],
];

// Source repo, configurable at build time: `PUBLIC_GITHUB_URL=https://github.com/you/agenthost`.
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL ?? "https://github.com/ceifa/agenthost";
// owner/repo slug for the install commands, derived from the URL above.
const repoSlug = githubUrl.replace(/^https?:\/\/github\.com\//, "").replace(/\.git$/, "") || "<owner>/<repo>";
// GitHub tree path to the skill folder, for agents that install from source.
const skillTreeUrl = `${githubUrl}/tree/main/skills/agenthost`;

// CLI installers — commands you run yourself.
const installs = [
  ["skills.sh", `npx skills add ${repoSlug} --skill agenthost`],
  ["Hermes", `hermes skills tap add ${repoSlug}`],
  ["OpenClaw", `openclaw skills install @ceifa/agenthost`],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>agenthost: sites and files in, private links out</title>
    <meta
      name="description"
      content="An AI agent publishes a site or uploads a large file directly to R2 and gets back a private share link for a human. Built as an Agent Skill on Cloudflare."
    />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%9A%80%3C/text%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --ink: #0e0f10;
        --surface: #16171a;
        --surface2: #0a0b0c;
        --line: #24262a;
        --line2: #33363b;
        --fg: #edeae3;
        --muted: #8b8d93;
        --faint: #5b5d63;
        --amber: #f2b544;
        --amber-dim: #b98420;
        --amber-soft: rgba(242, 181, 68, 0.12);
        --mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
        --sans: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--ink);
        color: var(--fg);
        font: 400 16px/1.65 var(--sans);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      a { color: var(--fg); text-decoration: none; }
      code { font-family: var(--mono); font-size: 0.86em; color: #cdb98f; }
      .wrap { max-width: 760px; margin: 0 auto; padding: 0 26px; }

      /* ---- header: brand on the left, two links on the right ---- */
      .top { padding: 30px 0 0; }
      .top .wrap { display: flex; align-items: baseline; gap: 20px; }
      .brand { font-family: var(--mono); font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
      .brand b { color: var(--amber); font-weight: 700; }
      .top nav { margin-left: auto; display: flex; gap: 20px; font-family: var(--mono); font-size: 13px; }
      .top nav a { color: var(--muted); }
      .top nav a:hover { color: var(--amber); }

      /* ---- hero ---- */
      .hero { padding: 58px 0 0; }
      h1 {
        font-family: var(--mono); font-weight: 600;
        font-size: clamp(29px, 6.4vw, 60px); line-height: 1.05; letter-spacing: -0.035em;
        margin: 0 0 16px;
      }
      h1 .out { color: var(--amber); }
      .lead { color: var(--muted); max-width: 56ch; margin: 0; font-size: 17px; }

      /* ---- terminal ---- */
      .term {
        margin-top: 30px;
        border: 1px solid var(--line2); border-radius: 12px; overflow: hidden;
        background: var(--surface2);
        box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(242, 181, 68, 0.04);
      }
      .term-bar {
        display: flex; align-items: center; gap: 8px;
        padding: 10px 16px; background: var(--surface); border-bottom: 1px solid var(--line);
        font-family: var(--mono); font-size: 12px; color: var(--faint);
      }
      .term-bar .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line2); }
      .term-bar .host { margin-left: 8px; letter-spacing: 0.02em; }
      .term-body { position: relative; padding: 20px 22px; overflow-x: auto; }
      .term-body::before {
        content: ""; position: absolute; inset: 0; pointer-events: none;
        background: repeating-linear-gradient(
          to bottom, transparent 0 3px, rgba(255, 255, 255, 0.014) 3px 4px
        );
      }
      .term pre { margin: 0; position: relative; font-family: var(--mono); font-size: 13px; line-height: 1.85; }
      .term .divider { height: 1px; background: var(--line); margin: 16px 0; border: 0; }
      .tp { color: var(--amber); font-weight: 600; }
      .tf { color: var(--muted); }
      .tu { color: #cdb98f; }
      .tb { color: var(--faint); }
      .tk { color: var(--muted); }
      .tv { color: var(--fg); }
      .tsec { color: var(--faint); }
      .tc { color: var(--faint); font-style: italic; }
      .thi {
        color: var(--amber); background: var(--amber-soft);
        padding: 1px 5px; border-radius: 4px; text-shadow: 0 0 18px rgba(242, 181, 68, 0.35);
      }

      /* ---- bare code lines, no box ---- */
      .snip { margin-top: 30px; }
      .snip .cap { font-family: var(--mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); }
      .snip pre {
        margin: 9px 0 0; padding-left: 15px; border-left: 1px solid var(--line2);
        font-family: var(--mono); font-size: 13px; line-height: 1.8; overflow-x: auto;
      }

      /* ---- sections ---- */
      section { padding: 56px 0 0; }
      h2 {
        font-family: var(--mono); font-weight: 600; font-size: 13px;
        letter-spacing: 0.13em; text-transform: uppercase; color: var(--amber-dim);
        margin: 0 0 4px;
      }

      /* ---- spec rows: label | one line ---- */
      .spec { margin: 0; padding: 0; }
      .spec > div {
        display: grid; grid-template-columns: 15.5em 1fr; gap: 20px;
        padding: 15px 0; border-bottom: 1px solid var(--line);
      }
      .spec > div:first-child { border-top: 1px solid var(--line); }
      .spec dt { font-family: var(--mono); font-size: 14px; font-weight: 500; }
      .spec dd { margin: 0; font-size: 14.5px; color: var(--muted); }

      /* ---- install rows ---- */
      .installs { margin: 18px 0 0; padding: 0; list-style: none; font-family: var(--mono); font-size: 13px; }
      .installs li { display: flex; gap: 14px; padding: 8px 0; }
      .installs .who { width: 8em; flex: none; color: var(--faint); }
      .installs .cmd { color: #cdb98f; }
      .paste { margin: 22px 0 0; font-size: 14.5px; color: var(--muted); }
      .paste q { font-family: var(--mono); font-size: 14px; color: var(--fg); quotes: "“" "”"; }
      .paste q .u { color: var(--amber); }
      a.lnk { color: var(--amber-dim); border-bottom: 1px solid transparent; }
      a.lnk:hover { color: var(--amber); border-bottom-color: var(--amber-dim); }

      /* ---- footer ---- */
      footer { margin-top: 58px; border-top: 1px solid var(--line); padding: 26px 0 56px; }
      footer .wrap { display: flex; flex-wrap: wrap; gap: 12px 22px; align-items: center; font-family: var(--mono); font-size: 13px; color: var(--faint); }
      footer a { color: var(--muted); }
      footer a:hover { color: var(--amber); }
      footer .gh { margin-left: auto; display: inline-flex; align-items: center; }
      .fine { margin: 14px 0 0; font-size: 13px; color: var(--faint); }

      :focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; border-radius: 4px; }

      /* Prose stays at a readable measure; the transcript bleeds past it so the
         publish one-liner and the shareUrl fit without a horizontal scroll. */
      @media (min-width: 920px) {
        .term { margin-left: -56px; margin-right: -56px; }
      }

      @media (max-width: 620px) {
        .spec > div { grid-template-columns: 1fr; gap: 5px; }
        .installs li { flex-direction: column; gap: 3px; }
        .installs .who { width: auto; }
      }
    </style>
  </head>
  <body>
    <div class="top">
      <div class="wrap">
        <span class="brand">🚀 agent<b>host</b></span>
        <nav>
          <a href="#skill">skill</a>
          <a href="/llms.txt">llms.txt</a>
          <a href={githubUrl} target="_blank" rel="noopener">github</a>
        </nav>
      </div>
    </div>

    <header class="hero">
      <div class="wrap">
        <h1>One file in.<br />A private link <span class="out">out.</span></h1>
        <p class="lead">
          Your agent publishes a site or sends a large file straight to R2, then gets back a
          private link to hand a human. Plain <code>curl</code>; no payload proxy.
        </p>

        <div class="term">
          <div class="term-bar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="host">agent@agenthost · publish</span>
          </div>
          <div class="term-body">
            <pre><code set:html={cmdHtml} /></pre>
            <hr class="divider" />
            <pre><code set:html={respHtml} /></pre>
          </div>
        </div>

        <div class="snip">
          <span class="cap">One file — skip the tar</span>
          <pre><code set:html={fileHtml} /></pre>
        </div>

        <div class="snip">
          <span class="cap">Redeploy — same URL, existing links keep working</span>
          <pre><code set:html={redeployHtml} /></pre>
        </div>
      </div>
    </header>

    <main>
      <section>
        <div class="wrap">
          <h2>What you get</h2>
          <dl class="spec">
            {spec.map(([t, d]) => (
              <div>
                <dt>{t}</dt>
                <dd set:html={d}></dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section id="skill">
        <div class="wrap">
          <h2>Install as an Agent Skill</h2>
          <p class="lead">
            agenthost is a <code>SKILL.md</code>. Its description tells the model to reach for it
            the moment built output needs to leave the machine — even without the word "publish."
          </p>
          <ul class="installs">
            {installs.map(([who, cmd]) => (
              <li><span class="who">{who}</span><span class="cmd">{cmd}</span></li>
            ))}
          </ul>
          <p class="paste">
            No CLI? Tell your agent: <q>Install the agenthost skill from <span class="u">https://agenthost.page</span></q>
            <br />Reading this as an agent? Load <a class="lnk" href={skillTreeUrl}>{repoSlug}/skills/agenthost</a> directly.
          </p>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <span>🚀 agenthost</span>
        <a href="/llms.txt">llms.txt</a>
        <a class="gh" href={githubUrl} target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        </a>
      </div>
      <div class="wrap"><p class="fine">Free to use. Every hosted site sends <code>X-Robots-Tag: noindex</code>. Caps and retention: see <a href="/llms.txt">llms.txt</a>.</p></div>
    </footer>
  </body>
</html>
