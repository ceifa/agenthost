---
// Three token roles only: prompt/punctuation (dim), values (fg), the payoff (accent).
const cmdHtml = `<span class="p">$</span> tar czf - -C ./dist . | curl -s --data-binary @- <span class="s">'https://agenthost.page/publish?id=myblog'</span>`;

// The JSON that comes back. shareUrl is the payoff and the only accent on the page.
const respHtml = `<span class="p">{</span>
  <span class="k">"shareUrl":</span>   <span class="hi">"https://cleverotter4f2-myblog.agenthost.page/?k=•••"</span>  <span class="c"># give this to a human</span>
  <span class="k">"url":</span>        <span class="s">"https://cleverotter4f2-myblog.agenthost.page/"</span>
  <span class="k">"username":</span>   <span class="s">"cleverotter4f2"</span>
  <span class="k">"ownerToken":</span> <span class="c">"••••••••••"</span>   <span class="c"># shown once, keep it</span>
  <span class="k">"accessKey":</span>  <span class="c">"••••••••••"</span>
<span class="p">}</span>`;

// Single-file publish, no tar step. The body is sniffed, so no header either.
const fileHtml = `<span class="p">$</span> curl -s --data-binary @report.md <span class="s">'https://agenthost.page/publish?id=report'</span>`;

// Same address, second time — needs only the token you kept.
const redeployHtml = `<span class="p">$</span> tar czf - -C ./dist . | curl -s --data-binary @- \\
    -H <span class="s">'Authorization: Bearer $OWNER_TOKEN'</span> \\
    <span class="s">'https://agenthost.page/publish?id=myblog&username=$USER'</span>`;

// Terse spec rows — label, then one line of fact.
const spec = [
  ["Private by default", "Every site sits behind an access key, and the share link signs a visitor in once. One POST makes it public, or rotates the key and kills every old link."],
  ["Large files, direct", "Videos and other binaries upload straight to R2, and the download button targets R2 too. Worker compute never touches the payload."],
  ["Markdown → docs", "A folder of <code>.md</code> becomes a sidebar'd site: <code>SUMMARY.md</code> ordering, GFM, mermaid. Mix in <code>.html</code> freely."],
  ["Own subdomain", "Each site is the root of its own subdomain, so <code>/css/app.css</code> and <code>./css/app.css</code> both resolve with nothing to configure."],
  ["Redeploy in place", "Keep the <code>ownerToken</code> and ship again to the exact same address. Read-after-write is strong, so you can verify the instant it returns."],
  ["Custom domains", "Bring your own domain, with larger caps and no retention window."],
];

// Source repo, configurable at build time: `PUBLIC_GITHUB_URL=https://github.com/you/agenthost`.
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL ?? "https://github.com/ceifa/agenthost";
// owner/repo slug for the install commands, derived from the URL above.
const repoSlug = githubUrl.replace(/^https?:\/\/github\.com\//, "").replace(/\.git$/, "") || "<owner>/<repo>";
// GitHub tree path to the skill folder, for agents that install from source.
const skillTreeUrl = `${githubUrl}/tree/main/skills/agenthost`;

// CLI installers — commands you run yourself.
const installs = [
  ["skills.sh", `npx skills add ${repoSlug} --skill agenthost`],
  ["Hermes", `hermes skills tap add ${repoSlug}`],
  ["OpenClaw", `openclaw skills install @ceifa/agenthost`],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>agenthost: sites and files in, private links out</title>
    <meta
      name="description"
      content="An AI agent publishes a site or uploads a large file directly to R2 and gets back a private share link for a human. Built as an Agent Skill on Cloudflare."
    />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%9A%80%3C/text%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* One typeface, four ink values. The amber appears exactly twice: the word
         "out." in the headline, and the shareUrl it produces in the transcript. */
      :root {
        --bg: #0c0d0f;
        --fg: #e9e7e2;
        --dim: #83868c;
        --line: #23252a;
        --accent: #f2b544;
        --mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font: 400 15px/1.7 var(--mono);
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      code { font: inherit; color: var(--fg); }
      .wrap { max-width: 720px; margin: 0 auto; padding: 0 26px; }

      /* ---- header ---- */
      .top .wrap { display: flex; align-items: baseline; gap: 24px; padding-top: 32px; }
      .brand { font-weight: 600; letter-spacing: -0.01em; }
      .top nav { margin-left: auto; display: flex; gap: 20px; color: var(--dim); font-size: 14px; }
      .top nav a:hover { color: var(--fg); }

      /* ---- hero ---- */
      .hero .wrap { padding-top: 76px; }
      h1 {
        font-weight: 600;
        font-size: clamp(30px, 6vw, 52px);
        line-height: 1.1;
        letter-spacing: -0.035em;
        margin: 0 0 18px;
      }
      h1 .out { color: var(--accent); }
      p { margin: 0; }
      .lead { color: var(--dim); max-width: 60ch; }

      /* ---- the one code treatment, used for every command on the page ---- */
      .block { margin-top: 38px; }
      .block .label { display: block; color: var(--dim); font-size: 13px; margin-bottom: 10px; }
      .block pre {
        margin: 0;
        font-family: var(--mono);
        font-size: 13px;
        line-height: 1.9;
        overflow-x: auto;
      }
      /* Only the hero transcript is boxed — it is the one moment on the page. */
      .transcript pre { padding: 20px 24px; border: 1px solid var(--line); }
      .block .rule { height: 1px; background: var(--line); margin: 14px 0; border: 0; }
      .p { color: var(--dim); }
      .k { color: var(--dim); }
      .s { color: var(--fg); }
      .c { color: var(--dim); }
      .hi { color: var(--accent); }

      /* ---- sections ---- */
      section .wrap { padding-top: 76px; }
      /* Section headings read as shell comments — this whole page is a transcript. */
      h2 { font-weight: 400; font-size: 15px; color: var(--dim); margin: 0 0 22px; }
      h2::before { content: "# "; }

      /* ---- spec rows: label | one line of fact ---- */
      .spec { margin: 0; padding: 0; }
      .spec > div {
        display: grid;
        grid-template-columns: 13em 1fr;
        gap: 28px;
        padding: 18px 0;
        border-top: 1px solid var(--line);
      }
      .spec > div:last-child { border-bottom: 1px solid var(--line); }
      .spec dt { font-weight: 500; font-size: 14px; }
      .spec dd { margin: 0; font-size: 14px; color: var(--dim); }
      .spec dd code { white-space: nowrap; }

      /* ---- install rows ---- */
      .installs { margin: 26px 0 0; padding: 0; list-style: none; font-size: 13px; }
      .installs li { display: flex; gap: 20px; padding: 7px 0; }
      .installs .who { width: 9em; flex: none; color: var(--dim); }
      .note { margin-top: 28px; font-size: 14px; color: var(--dim); }
      .note a { border-bottom: 1px solid var(--line); }
      .note a:hover { color: var(--fg); border-bottom-color: var(--dim); }

      /* ---- footer ---- */
      footer .wrap {
        margin-top: 76px;
        border-top: 1px solid var(--line);
        padding-top: 24px;
        padding-bottom: 60px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px 22px;
        align-items: center;
        font-size: 13px;
        color: var(--dim);
      }
      footer a:hover { color: var(--fg); }
      footer .gh { margin-left: auto; display: inline-flex; }

      :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

      /* The transcript bleeds past the prose measure so the publish one-liner and
         the shareUrl fit without a horizontal scroll. */
      @media (min-width: 880px) {
        .bleed { margin-left: -70px; margin-right: -70px; }
      }

      @media (max-width: 620px) {
        .spec > div { grid-template-columns: 1fr; gap: 6px; }
        .installs li { flex-direction: column; gap: 2px; }
        .installs .who { width: auto; }
      }
    </style>
  </head>
  <body>
    <div class="top">
      <div class="wrap">
        <span class="brand">agenthost</span>
        <nav>
          <a href="#skill">skill</a>
          <a href="/llms.txt">llms.txt</a>
          <a href={githubUrl} target="_blank" rel="noopener">github</a>
        </nav>
      </div>
    </div>

    <header class="hero">
      <div class="wrap">
        <h1>One file in.<br />A private link <span class="out">out.</span></h1>
        <p class="lead">
          Your agent publishes a site or sends a large file straight to R2, then gets back a
          private link to hand a human. Plain <code>curl</code>, nothing to install.
        </p>

        <div class="block transcript bleed">
          <pre><code set:html={cmdHtml} /><hr class="rule" /><code set:html={respHtml} /></pre>
        </div>

        <div class="block">
          <span class="label">One file — skip the tar</span>
          <pre><code set:html={fileHtml} /></pre>
        </div>

        <div class="block">
          <span class="label">Redeploy — same URL, existing links keep working</span>
          <pre><code set:html={redeployHtml} /></pre>
        </div>
      </div>
    </header>

    <main>
      <section>
        <div class="wrap">
          <h2>What you get</h2>
          <dl class="spec">
            {spec.map(([t, d]) => (
              <div>
                <dt>{t}</dt>
                <dd set:html={d}></dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section id="skill">
        <div class="wrap">
          <h2>Install as an Agent Skill</h2>
          <p class="lead">
            agenthost is a <code>SKILL.md</code>. Its description tells the model to reach for it
            the moment built output needs to leave the machine.
          </p>
          <ul class="installs">
            {installs.map(([who, cmd]) => (
              <li><span class="who">{who}</span><span class="cmd">{cmd}</span></li>
            ))}
          </ul>
          <p class="note">
            No CLI? Tell your agent to install the agenthost skill from agenthost.page.
            Reading this as an agent? Load <a href={skillTreeUrl}>{repoSlug}/skills/agenthost</a> directly.
          </p>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <span>agenthost</span>
        <a href="/llms.txt">llms.txt</a>
        <span>Free to use. Hosted sites send <code>X-Robots-Tag: noindex</code>.</span>
        <a class="gh" href={githubUrl} target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        </a>
      </div>
    </footer>
  </body>
</html>
