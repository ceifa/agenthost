---
// DESIGN 2 — "Dispatch": editorial. The page is a letter from a machine to a
// person. Fraunces for the voice, Plex Sans for the prose, mono only inside
// exhibits. Signature: the shareUrl set as a display line mid-page — the thing
// that actually gets handed over, typeset at the size it deserves.
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL ?? "https://github.com/ceifa/agenthost";
const repoSlug = githubUrl.replace(/^https?:\/\/github\.com\//, "").replace(/\.git$/, "");

const cmdHtml = `<span class="p">$</span> tar czf - -C ./dist . | curl -s --data-binary @- \\
    <span class="s">'https://agenthost.page/publish?id=myblog'</span>`;
const respHtml = `<span class="p">{</span>
  <span class="k">"url":</span>        <span class="s">"https://cleverotter4f2-myblog.agenthost.page/"</span>
  <span class="k">"username":</span>   <span class="s">"cleverotter4f2"</span>
  <span class="k">"ownerToken":</span> <span class="c">"••••••••••"</span>
  <span class="k">"accessKey":</span>  <span class="c">"••••••••••"</span>
<span class="p">}</span>`;
const fileHtml = `<span class="p">$</span> curl -s --data-binary @report.md \\
    <span class="s">'https://agenthost.page/publish?id=report'</span>`;
const redeployHtml = `<span class="p">$</span> tar czf - -C ./dist . | curl -s --data-binary @- \\
    -H <span class="s">'Authorization: Bearer $OWNER_TOKEN'</span> \\
    <span class="s">'https://agenthost.page/publish?id=myblog&username=$USER'</span>`;

const installs = [
  ["skills.sh", `npx skills add ${repoSlug} --skill agenthost`],
  ["Hermes", `hermes skills tap add ${repoSlug}`],
  ["OpenClaw", `openclaw skills install @ceifa/agenthost`],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>agenthost — dispatch</title>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --paper: #eceef1;
        --ink: #0e1116;
        --mute: #5c6570;
        --rule: #cfd5dc;
        --blue: #1f3fd6;
        --display: "Fraunces", Georgia, serif;
        --sans: "IBM Plex Sans", system-ui, sans-serif;
        --mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--paper); color: var(--ink);
        font: 400 16px/1.65 var(--sans); -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 40px; }

      .masthead {
        display: flex; align-items: baseline; gap: 26px;
        padding: 26px 0 18px; border-bottom: 2px solid var(--ink);
      }
      .masthead .brand { font: 600 20px/1 var(--display); letter-spacing: -0.01em; }
      .masthead nav { margin-left: auto; display: flex; gap: 22px; font-size: 13px; color: var(--mute); }
      .masthead nav a:hover { color: var(--blue); }

      /* hero: display left, standfirst right, on a real column break */
      .hero { display: grid; grid-template-columns: 1.35fr 1fr; gap: 56px; padding: 72px 0 8px; }
      h1 {
        margin: 0; font-family: var(--display); font-weight: 400;
        font-size: clamp(44px, 7vw, 86px); line-height: 0.98; letter-spacing: -0.03em;
        font-variation-settings: "SOFT" 0, "WONK" 1;
      }
      h1 em { font-style: italic; color: var(--blue); }
      .standfirst { align-self: end; }
      .standfirst p { margin: 0; font-size: 17px; color: var(--mute); }
      .standfirst .kicker {
        font: 500 11px/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--blue); display: block; margin-bottom: 14px;
      }

      /* exhibits: code as a cited document, not a widget */
      .exhibit { margin-top: 52px; border-top: 1px solid var(--rule); padding-top: 18px; }
      .exhibit > .cap {
        font: 500 11px/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--mute); display: block; margin-bottom: 16px;
      }
      .exhibit pre {
        margin: 0; font: 400 13px/1.9 var(--mono); overflow-x: auto;
        border-left: 2px solid var(--blue); padding-left: 20px;
      }
      .p, .k, .c { color: var(--mute); }
      .s { color: var(--ink); }

      /* signature: the link, set as display type */
      .handoff { margin: 64px 0 0; padding: 44px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
      .handoff .cap {
        font: 500 11px/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--mute); display: block; margin-bottom: 22px;
      }
      .handoff .link {
        font-family: var(--display); font-weight: 400;
        font-size: clamp(22px, 3.4vw, 40px); line-height: 1.15; letter-spacing: -0.02em;
        word-break: break-all; color: var(--blue);
      }
      .handoff .link .k { color: var(--ink); opacity: 0.35; }
      .handoff .after { margin: 20px 0 0; font-size: 15px; color: var(--mute); max-width: 58ch; }
      /* the handoff already closes with a rule — don't stack a second one under it */
      .handoff + .exhibit { border-top: 0; margin-top: 40px; }

      section { padding-top: 76px; }
      h2 { font: 400 30px/1.1 var(--display); letter-spacing: -0.02em; margin: 0 0 16px; }
      .lede { margin: 0; color: var(--mute); max-width: 56ch; }
      .installs { margin: 30px 0 0; padding: 0; list-style: none; }
      .installs li {
        display: grid; grid-template-columns: 9em 1fr; gap: 24px;
        padding: 13px 0; border-top: 1px solid var(--rule); font: 400 13px/1.6 var(--mono);
      }
      .installs li:last-child { border-bottom: 1px solid var(--rule); }
      .installs .who { color: var(--mute); }
      .note { margin-top: 24px; font-size: 14px; color: var(--mute); max-width: 62ch; }
      .note a { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }

      footer {
        margin-top: 86px; border-top: 2px solid var(--ink);
        padding: 20px 0 64px; display: flex; flex-wrap: wrap; gap: 10px 26px;
        font-size: 13px; color: var(--mute); align-items: center;
      }
      footer a:hover { color: var(--blue); }
      footer .gh { margin-left: auto; }
      :focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
      @media (max-width: 860px) {
        .wrap { padding: 0 24px; }
        .hero { grid-template-columns: 1fr; gap: 28px; }
        .installs li { grid-template-columns: 1fr; gap: 2px; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="masthead">
        <span class="brand">agenthost</span>
        <nav>
          <a href="#skill">skill</a>
          <a href="/llms.txt">llms.txt</a>
          <a href={githubUrl}>github</a>
        </nav>
      </div>

      <header class="hero">
        <h1>One file in.<br />A private link <em>out.</em></h1>
        <div class="standfirst">
          <span class="kicker">Publishing for agents</span>
          <p>Your agent publishes a site or sends a large file, then gets back a private link to
          hand a human. Plain <code>curl</code>, nothing to install.</p>
        </div>
      </header>

      <div class="exhibit">
        <span class="cap">Publish a built folder</span>
        <pre><code set:html={cmdHtml} /></pre>
      </div>

      <div class="handoff">
        <span class="cap">What comes back, and what you give away</span>
        <div class="link">https://cleverotter4f2-myblog.agenthost.page/<span class="k">?k=•••</span></div>
        <p class="after">That link signs a visitor in once. The rest of the response — the owner
        token and the access key — stays with your agent.</p>
      </div>

      <div class="exhibit">
        <span class="cap">The full response</span>
        <pre><code set:html={respHtml} /></pre>
      </div>

      <div class="exhibit">
        <span class="cap">One file — skip the tar</span>
        <pre><code set:html={fileHtml} /></pre>
      </div>

      <div class="exhibit">
        <span class="cap">Redeploy — same URL, existing links keep working</span>
        <pre><code set:html={redeployHtml} /></pre>
      </div>

      <section id="skill">
        <h2>Install as an Agent Skill</h2>
        <p class="lede">agenthost is a <code>SKILL.md</code>. Its description tells the model to
        reach for it the moment built output needs to leave the machine.</p>
        <ul class="installs">
          {installs.map(([who, cmd]) => (<li><span class="who">{who}</span><span>{cmd}</span></li>))}
        </ul>
        <p class="note">No CLI? Tell your agent to install the agenthost skill from agenthost.page.
        Reading this as an agent? Load <a href={`${githubUrl}/tree/main/skills/agenthost`}>{repoSlug}/skills/agenthost</a> directly.</p>
      </section>

      <footer>
        <span>agenthost</span>
        <a href="/llms.txt">llms.txt</a>
        <span>Free to use. Hosted sites send X-Robots-Tag: noindex.</span>
        <a class="gh" href={githubUrl}>github</a>
      </footer>
    </div>
  </body>
</html>
