---
import SeoHead from "../components/SeoHead.astro";

interface Props {
  frontmatter: { title: string; description: string };
}

const { title, description } = Astro.props.frontmatter;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={`${title} | agenthost`} description={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header><a href="/" class="brand">agenthost</a><span>Publishing guides</span></header>
    <main>
      <article>
        <h1>{title}</h1>
        <slot />
      </article>
    </main>
    <footer><a href="/">Try agenthost</a><a href="/llms.txt">Publishing API</a></footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0c0d0f;
    --fg: #ebe8e1;
    --dim: #a5a6ab;
    --line: #24262b;
    --accent: #f2b544;
    --sans: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, monospace;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 400 18px/1.7 var(--sans); }
  header, main, footer { max-width: 880px; margin: 0 auto; padding: 0 28px; }
  header { padding-top: 36px; display: flex; justify-content: space-between; gap: 16px; color: var(--dim); font-size: 14px; }
  .brand { font-family: var(--mono); color: var(--fg); text-decoration: none; }
  main { padding-top: 64px; }
  h1 { font-size: clamp(34px, 5.5vw, 52px); line-height: 1.12; letter-spacing: -0.03em; margin: 0 0 28px; }
  h2 { font-size: 28px; line-height: 1.25; margin: 56px 0 18px; letter-spacing: -0.02em; }
  h3 { font-size: 21px; line-height: 1.4; margin: 32px 0 12px; }
  p, li { color: var(--dim); }
  p { margin: 0 0 20px; }
  strong { color: var(--fg); font-weight: 600; }
  a { color: var(--accent); text-underline-offset: 4px; }
  a:hover { color: var(--fg); }
  li { margin: 8px 0; }
  blockquote { margin: 24px 0; padding: 4px 0 4px 22px; border-left: 3px solid var(--accent); }
  blockquote p { margin: 0; color: var(--fg); }
  code { font: 400 0.85em/1.6 var(--mono); overflow-wrap: anywhere; }
  :not(pre) > code { color: var(--fg); background: #18191c; padding: 2px 5px; }
  pre { padding: 22px; border: 1px solid var(--line); overflow-x: auto; max-width: 100%; }
  pre code { overflow-wrap: normal; }
  footer { margin-top: 72px; padding-top: 24px; padding-bottom: 48px; display: flex; gap: 24px; border-top: 1px solid var(--line); font-size: 15px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 560px) {
    body { font-size: 17px; }
    header, main, footer { padding-left: 20px; padding-right: 20px; }
    main { padding-top: 48px; }
    pre { padding: 16px; }
  }
</style>
