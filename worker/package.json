{
  "name": "@agenthost/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "dev": "pnpm run build:client && node ../scripts/wrangler.mjs dev",
    "deploy": "pnpm run build:client && node ../scripts/wrangler.mjs deploy",
    "types": "node ../scripts/wrangler.mjs types",
    "typecheck": "pnpm run build:client && tsc --noEmit && tsc --noEmit -p src/client",
    "test": "pnpm run build:client && vitest run"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.13",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "rolldown": "^1.2.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
