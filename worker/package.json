{
  "name": "@agenthost/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "codegen": "node scripts/codegen.mjs",
    "dev": "pnpm run codegen && node ../scripts/wrangler.mjs dev",
    "deploy": "pnpm run codegen && node ../scripts/wrangler.mjs deploy",
    "types": "node ../scripts/wrangler.mjs types",
    "typecheck": "pnpm run codegen && tsc --noEmit && tsc --noEmit -p src/client",
    "test": "pnpm run codegen && vitest run"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "highlight.js": "^11.12.0",
    "hono": "^4.6.20",
    "marked": "^15.0.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "rolldown": "^1.2.9",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.103.0"
  }
}
